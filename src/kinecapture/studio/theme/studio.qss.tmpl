/* KineCapture Studio stylesheet template.
 *
 * Every value is a placeholder (token name between at-signs) resolved from
 * tokens.json by generator.py. A literal colour is a bug here: the generator
 * refuses to emit a stylesheet that still contains an unresolved placeholder,
 * and tests/test_studio_layers.py refuses to let a literal hex colour in.
 *
 * Character: a calm ladder of greys, measured soft corners, 1px separators
 * instead of frames, and colour that always means something.
 *
 * The rule this file exists to keep: *this product owns every surface.* Qt
 * falls back to the platform palette for anything a stylesheet does not
 * mention - and on Windows 11 that palette follows the system theme, which
 * is how the light theme ended up with dark islands in it. So scroll-area
 * viewports, item views, tabs, menus, headers, tool windows and spin boxes
 * are all named here, whether or not they look wrong today.
 */

QWidget {
    color: @KcTextPrimary@;
    font-family: @KcFontFamily@;
    font-size: @KcFontSizeMd@px;
}

QMainWindow, QDialog {
    background-color: @KcSurfaceBase@;
}

QWidget:disabled {
    /* Dimmed, still readable: a control nobody can use still has to say what
     * it would have done. */
    color: @KcTextDisabled@;
}

/* Labels never paint their own ground. Without this a label inside a warning
 * band keeps the base surface colour and cuts a lighter stripe through it. */
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

/* The gap between a tick and the word it belongs to. Without it the
 * two read as one smudged shape. */
QCheckBox, QRadioButton {
    spacing: @KcSpacingMd@px;
    padding: @KcSpacingXs@px 0;
}

QToolTip {
    background-color: @KcSurfaceOverlay@;
    color: @KcTextPrimary@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingMd@px @KcSpacingLg@px;
}

/* ----------------------------------------------------------- surfaces */

/* A surface that draws a border keeps its contents off it. Qt's box model
   applies this padding to the widget's contents rect, so the layout inside is
   inset without every caller remembering to set margins - which is how text
   ended up sitting on the border line in the 16 September screenshots. */
QFrame[kcSurface="raised"] {
    background-color: @KcSurfaceRaised@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSurface@px;
    padding: @KcSpacingXl@px;
}

QFrame[kcSurface="sunken"] {
    background-color: @KcSurfaceSunken@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSurface@px;
    padding: @KcSpacingXl@px;
}

QFrame[kcSurface="viewport"] {
    background-color: @KcSurfaceViewport@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSmall@px;
}

/* The labelling screen's working surface: video, 3-D and the editing panel
 * inside one outer frame, divided by rules rather than separated by gaps.
 * Without this they read as three unrelated cards, which is exactly what the
 * 19 September design review objected to. The padding is deliberately zero -
 * the three regions meet their own frame edge. */
QFrame[kcSurface="stage"] {
    background-color: @KcSurfaceStage@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSurface@px;
    padding: 0;
}

/* A toolbar-like strip: the same family as the panel it sits on, one step up. */
QWidget[kcSurface="header"], QFrame[kcSurface="header"] {
    background-color: @KcSurfaceHeader@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingMd@px @KcSpacingLg@px;
}

QFrame[kcSeparator="horizontal"] {
    background-color: @KcBorderSubtle@;
    max-height: @KcBorderWidth@px;
    min-height: @KcBorderWidth@px;
    border: none;
}

QFrame[kcSeparator="vertical"] {
    background-color: @KcBorderSubtle@;
    max-width: @KcBorderWidth@px;
    min-width: @KcBorderWidth@px;
    border: none;
}

/* ------------------------------------------------------------ context bar */

QFrame#kcContextBar {
    background-color: @KcSurfaceHeader@;
    border-bottom: @KcBorderWidth@px solid @KcBorderSubtle@;
}

QWidget#kcRecordingStrip {
    background: transparent;
}

QLabel[kcRole="contextKey"] {
    color: @KcTextMuted@;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcRole="contextValue"] {
    color: @KcTextPrimary@;
    font-size: @KcFontSizeSm@px;
}

QLabel[kcRole="mono"] {
    font-family: @KcFontMono@;
    font-size: @KcFontSizeSm@px;
}

QLabel[kcRole="pageTitle"] {
    font-size: @KcFontSizeTitle@px;
    font-weight: @KcFontWeightMedium@;
}

QLabel[kcRole="pageSubtitle"] {
    color: @KcTextSecondary@;
    font-size: @KcFontSizeSm@px;
}

/* An inline problem under a field. Coloured, not filled: a red band across
 * the whole row reads as a page-level failure, which it is not. */
QLabel[kcRole="fieldError"] {
    color: @KcStatusRecording@;
    font-size: @KcFontSizeSm@px;
}

QLabel[kcRole="fieldCost"] {
    color: @KcStatusWarning@;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcRole="sectionTitle"] {
    color: @KcTextMuted@;
    font-size: @KcFontSizeXs@px;
    font-weight: @KcFontWeightMedium@;
    letter-spacing: 1px;
}

/* The name of one setting: a little heavier than body text, so a column of
 * settings reads as a list of things rather than a wall of sentences. */
QLabel[kcRole="fieldLabel"] {
    color: @KcTextPrimary@;
    font-size: @KcFontSizeMd@px;
    font-weight: @KcFontWeightMedium@;
}

/* When a saved change starts to matter. Quiet: it is a qualifier, not news. */
QLabel[kcRole="fieldApplies"] {
    color: @KcTextMuted@;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcRole="section"] {
    color: @KcTextPrimary@;
    font-size: @KcFontSizeLg@px;
    font-weight: @KcFontWeightMedium@;
}

/* The product's own name, on the sign-in screen and nowhere else. The brand
 * face is used here alone: turning body text into a display face costs
 * legibility and buys nothing. */
QLabel[kcRole="brandMark"] {
    color: @KcTextPrimary@;
    font-family: @KcFontBrand@;
    font-size: @KcFontSizeDisplay@px;
    font-weight: @KcFontWeightMedium@;
    letter-spacing: 0px;
}

/* A short line naming which editor the panel is showing. Colour is an
 * accompaniment to the word, never a replacement for it. */
QLabel[kcContext="summary"] {
    color: @KcContextSummary@;
    font-size: @KcFontSizeSm@px;
    font-weight: @KcFontWeightMedium@;
}

QLabel[kcContext="movement"] {
    color: @KcContextMovement@;
    font-size: @KcFontSizeSm@px;
    font-weight: @KcFontWeightMedium@;
}

QLabel[kcContext="fault"] {
    color: @KcContextFault@;
    font-size: @KcFontSizeSm@px;
    font-weight: @KcFontWeightMedium@;
}

/* ------------------------------------------------------------- status pill */

QLabel[kcStatus="neutral"] {
    color: @KcTextSecondary@;
    background-color: @KcSurfaceControl@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcStatus="live"] {
    color: @KcStatusLive@;
    background-color: @KcStatusLiveMuted@;
    border: @KcBorderWidth@px solid @KcStatusLive@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcStatus="ready"] {
    color: @KcStatusLive@;
    background-color: @KcStatusLiveMuted@;
    border: @KcBorderWidth@px solid @KcStatusLive@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcStatus="warning"] {
    color: @KcStatusWarning@;
    background-color: @KcStatusWarningMuted@;
    border: @KcBorderWidth@px solid @KcStatusWarning@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcStatus="error"] {
    color: @KcStatusRecording@;
    background-color: @KcStatusRecordingMuted@;
    border: @KcBorderWidth@px solid @KcStatusRecording@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
}

QLabel[kcStatus="info"] {
    color: @KcTextSecondary@;
    background-color: @KcSurfaceControl@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSmall@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
}

/* A number in a readout row is coloured, never boxed.
 *
 * The pill above is right for a word - "hazır", "kapsam doğrulanamadı" - and
 * wrong for a figure: a border and padding around a two-character value reads
 * as a clipped control, and the padding moves every readout after it the
 * moment the state changes. The mono face already says "this is a number", so
 * here the state is carried by colour and weight alone. */
QLabel[kcRole="mono"][kcStatus="live"],
QLabel[kcRole="mono"][kcStatus="ready"],
QLabel[kcRole="mono"][kcStatus="warning"],
QLabel[kcRole="mono"][kcStatus="error"],
QLabel[kcRole="mono"][kcStatus="neutral"],
QLabel[kcRole="mono"][kcStatus="info"] {
    background: transparent;
    border: none;
    padding: 0;
    font-family: @KcFontMono@;
    font-size: @KcFontSizeSm@px;
    font-weight: @KcFontWeightMedium@;
}

QLabel[kcRole="mono"][kcStatus="error"] {
    color: @KcStatusRecording@;
}

QLabel[kcRole="mono"][kcStatus="warning"] {
    color: @KcStatusWarning@;
}

QLabel[kcRole="mono"][kcStatus="live"],
QLabel[kcRole="mono"][kcStatus="ready"] {
    color: @KcStatusLive@;
}

QLabel[kcRole="mono"][kcStatus="neutral"],
QLabel[kcRole="mono"][kcStatus="info"] {
    color: @KcTextSecondary@;
}

/* ------------------------------------------------------ switches and radios */
/* Drawn from tokens rather than left to the native style: the platform
 * indicator is painted for a light palette and all but disappears on this
 * one, which turns a two-state control into a guess. */

QCheckBox::indicator, QRadioButton::indicator {
    width: @KcIconSize@px;
    height: @KcIconSize@px;
    background-color: @KcSurfaceControl@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
}

QCheckBox::indicator {
    border-radius: @KcRadiusSmall@px;
}

/* Half the indicator's own size: Qt draws a square if the radius is larger,
 * which turns the one control whose *shape* says "pick exactly one" into a
 * second checkbox. */
QRadioButton::indicator {
    border-radius: @KcRadiusRound@px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: @KcAccentPrimary@;
    background-color: @KcSurfaceControlHover@;
}

QCheckBox::indicator:checked {
    background-color: @KcAccentPrimary@;
    border-color: @KcAccentPrimary@;
    image: url(kc:check.svg);
}

QRadioButton::indicator:checked {
    /* An accent dot inside a round outline. Drawn as an image rather than as a
     * thick border: a border that wide makes Qt ignore the radius and paint a
     * square, which turns the one control whose *shape* means "exactly one"
     * into a second checkbox. */
    background-color: @KcSurfaceControl@;
    border: @KcBorderWidth@px solid @KcAccentPrimary@;
    border-radius: @KcRadiusRound@px;
    image: url(kc:radio-dot.svg);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: @KcSurfaceBase@;
    border-color: @KcBorderSubtle@;
}

QCheckBox:focus, QRadioButton:focus {
    color: @KcFocusRing@;
}

/* ----------------------------------------------------------------- buttons */

QPushButton {
    background-color: @KcSurfaceControl@;
    color: @KcTextPrimary@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    border-radius: @KcRadiusControl@px;
    padding: @KcSpacingMd@px @KcSpacingXl@px;
    min-height: @KcControlHeight@px;
}

QPushButton:hover {
    background-color: @KcSurfaceControlHover@;
    border-color: @KcBorderStrong@;
}

QPushButton:pressed {
    background-color: @KcSurfaceControlActive@;
}

QPushButton:focus {
    border: @KcBorderWidthStrong@px solid @KcFocusRing@;
}

QPushButton:disabled {
    color: @KcTextDisabled@;
    background-color: @KcSurfaceBase@;
    border-color: @KcBorderSubtle@;
}

QPushButton[kcVariant="primary"] {
    background-color: @KcAccentPrimary@;
    color: @KcTextOnAccent@;
    border-color: @KcAccentPrimary@;
    font-weight: @KcFontWeightMedium@;
}

QPushButton[kcVariant="primary"]:hover {
    background-color: @KcAccentPrimaryHover@;
    border-color: @KcAccentPrimaryHover@;
}

QPushButton[kcVariant="primary"]:disabled {
    background-color: @KcAccentMuted@;
    border-color: @KcAccentMuted@;
    color: @KcTextDisabled@;
}

QPushButton[kcVariant="quiet"] {
    background-color: transparent;
    border-color: transparent;
    color: @KcTextSecondary@;
}

QPushButton[kcVariant="quiet"]:hover {
    background-color: @KcSurfaceControlHover@;
    color: @KcTextPrimary@;
}

QPushButton[kcVariant="quiet"]:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* Ends something that is running. Recording red, and nothing else uses it. */
QPushButton[kcVariant="danger"] {
    background-color: @KcStatusRecordingMuted@;
    border-color: @KcStatusRecording@;
    color: @KcStatusRecording@;
    font-weight: @KcFontWeightMedium@;
}

QPushButton[kcVariant="danger"]:hover {
    background-color: @KcStatusRecording@;
    color: @KcTextOnAccent@;
}

/* ------------------------------------------------------------ tool buttons */

QToolButton {
    background-color: transparent;
    color: @KcTextSecondary@;
    border: @KcBorderWidth@px solid transparent;
    border-radius: @KcRadiusControl@px;
    padding: @KcSpacingMd@px @KcSpacingLg@px;
}

QToolButton:hover {
    background-color: @KcSurfaceControlHover@;
    color: @KcTextPrimary@;
}

QToolButton:pressed {
    background-color: @KcSurfaceControlActive@;
}

QToolButton:checked {
    background-color: @KcAccentMuted@;
    border-color: @KcAccentPrimary@;
    color: @KcTextPrimary@;
}

QToolButton:focus {
    border: @KcBorderWidthStrong@px solid @KcFocusRing@;
}

QToolButton:disabled {
    color: @KcTextDisabled@;
}

QToolButton::menu-indicator {
    image: none;
}

/* A square icon button: the transport, the tool row, the panel's icon strip.
 * One size everywhere, so a row of them has one optical rhythm and the
 * baseline of the text beside them does not move. Width and height are equal
 * and fixed here rather than in each caller. */
QToolButton[kcRole="iconButton"], QPushButton[kcRole="iconButton"] {
    min-width: @KcIconButtonSize@px;
    max-width: @KcIconButtonSize@px;
    min-height: @KcIconButtonSize@px;
    max-height: @KcIconButtonSize@px;
    padding: 0;
    border-radius: @KcRadiusControl@px;
}

/* The same button in the vertical strip down the panel's right edge. It is
 * checkable and its checked state has to read at a glance, because it is what
 * says which of the three views the panel is showing. */
QToolButton[kcRole="stripButton"] {
    min-width: @KcIconButtonSize@px;
    max-width: @KcIconButtonSize@px;
    min-height: @KcIconButtonSize@px;
    max-height: @KcIconButtonSize@px;
    padding: 0;
    border-radius: @KcRadiusControl@px;
}

QToolButton[kcRole="stripButton"]:checked {
    background-color: @KcSurfaceControlActive@;
    border-color: @KcBorderStrong@;
}

/* A class on the editor band's quick-select row. It has a surface and a
 * border even when it is not the chosen one, because a bare QToolButton
 * beside a text field reads as a word rather than as something to press -
 * which is what the 21 September review said about several of these rows.
 * The chosen one is unmistakable: accent fill, accent border, primary text. */
QToolButton[kcRole="classChip"] {
    background-color: @KcSurfaceControl@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    color: @KcTextPrimary@;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
}

QToolButton[kcRole="classChip"]:hover {
    background-color: @KcSurfaceControlHover@;
}

QToolButton[kcRole="classChip"]:checked {
    background-color: @KcAccentMuted@;
    border: @KcBorderWidthStrong@px solid @KcAccentPrimary@;
    color: @KcTextPrimary@;
    font-weight: @KcFontWeightMedium@;
}

/* A control that starts or stops a recording. Red, and only here: the shape
 * (dot / square) carries the same meaning for anyone who cannot see the hue. */
QPushButton[kcVariant="record"] {
    background-color: @KcStatusRecording@;
    border-color: @KcStatusRecording@;
    color: @KcTextOnAccent@;
    font-weight: @KcFontWeightMedium@;
}

QPushButton[kcVariant="record"]:hover {
    background-color: @KcStatusRecordingMuted@;
    color: @KcStatusRecording@;
}

QPushButton[kcVariant="record"]:disabled {
    background-color: @KcSurfaceBase@;
    border-color: @KcBorderSubtle@;
    color: @KcTextDisabled@;
}

/* The camera connection, in the transport row beside the record button. Green
 * while the camera is open - the *only* place the Capture screen states the
 * connection, since the status block and the "etkin" pill were removed on
 * 21 September. The wording changes with the colour ("Bağlan" becomes
 * "Bağlantıyı kes"), so the state is never hue alone. */
QPushButton[kcConnected="connected"] {
    background-color: @KcStatusLive@;
    border-color: @KcStatusLive@;
    color: @KcTextOnAccent@;
    font-weight: @KcFontWeightMedium@;
}

QPushButton[kcConnected="connected"]:hover {
    background-color: @KcStatusLiveMuted@;
    color: @KcStatusLive@;
}

QPushButton[kcConnected="connecting"] {
    background-color: @KcSurfaceControl@;
    border-color: @KcStatusWarning@;
    color: @KcStatusWarning@;
}

/* -------------------------------------------------------------- navigation */

QFrame#kcNavBar {
    background-color: @KcSurfaceHeader@;
    border-top: @KcBorderWidth@px solid @KcBorderSubtle@;
}

QToolButton[kcRole="navItem"] {
    background-color: transparent;
    color: @KcTextSecondary@;
    border: none;
    border-top: @KcSpacingXs@px solid transparent;
    border-radius: 0;
    padding: @KcSpacingMd@px @KcSpacingLg@px @KcSpacingMd@px @KcSpacingLg@px;
    font-size: @KcFontSizeSm@px;
}

QToolButton[kcRole="navItem"]:hover {
    background-color: @KcSurfaceControlHover@;
    color: @KcTextPrimary@;
}

QToolButton[kcRole="navItem"]:checked {
    color: @KcTextPrimary@;
    background-color: @KcSurfaceBase@;
    border-top: @KcSpacingXs@px solid @KcAccentPrimary@;
    font-weight: @KcFontWeightMedium@;
}

QToolButton[kcRole="navItem"]:focus {
    border-bottom: @KcBorderWidthStrong@px solid @KcFocusRing@;
}

/* A step this session cannot enter yet. Dimmed like a disabled control, but
 * still a control: pressing it has to say what is missing, and Qt sends no
 * click from something that is genuinely disabled. */
QToolButton[kcRole="navItem"][kcGated="true"] {
    color: @KcTextDisabled@;
}

QToolButton[kcRole="navItem"][kcGated="true"]:hover {
    color: @KcTextDisabled@;
    background-color: @KcSurfaceControlHover@;
}

/* --------------------------------------------------------------- inspector */

QFrame#kcInspector {
    background-color: @KcSurfaceRaised@;
    border-left: @KcBorderWidth@px solid @KcBorderSubtle@;
}

/* ------------------------------------------------------------ input fields */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @KcSurfaceControl@;
    color: @KcTextPrimary@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    border-radius: @KcRadiusControl@px;
    padding: @KcSpacingSm@px @KcSpacingLg@px;
    min-height: @KcControlHeight@px;
    selection-background-color: @KcAccentPrimary@;
    selection-color: @KcTextOnAccent@;
}

QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: @KcTextMuted@;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: @KcBorderWidthStrong@px solid @KcFocusRing@;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: @KcSurfaceBase@;
    border-color: @KcBorderSubtle@;
    color: @KcTextDisabled@;
}

QLineEdit[kcState="error"], QSpinBox[kcState="error"], QComboBox[kcState="error"] {
    border-color: @KcStatusRecording@;
}

/* A caption living inside its own box has to read as a prompt, not as a value
 * somebody already typed. Muted rather than secondary: one step quieter than
 * real text at the same size. */
QLineEdit {
    placeholder-text-color: @KcTextMuted@;
}

QComboBox::drop-down {
    border: none;
    width: @KcIconSizeLarge@px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: url(kc:chevron-down.svg);
    width: @KcIconSize@px;
    height: @KcIconSize@px;
}

QComboBox QAbstractItemView {
    background-color: @KcSurfaceOverlay@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    border-radius: @KcRadiusControl@px;
    padding: @KcSpacingXs@px;
    selection-background-color: @KcSurfaceSelected@;
    selection-color: @KcTextPrimary@;
    outline: none;
}

/* The platform spin arrows are drawn for the platform palette and vanish on
 * ours; these are ours. */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: @KcSurfaceControlHover@;
    border: none;
    border-left: @KcBorderWidth@px solid @KcBorderSubtle@;
    width: @KcIconSizeLarge@px;
    subcontrol-origin: border;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: @KcRadiusControl@px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: @KcRadiusControl@px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @KcSurfaceControlActive@;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(kc:chevron-up.svg);
    width: @KcIconSize@px;
    height: @KcIconSize@px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(kc:chevron-down.svg);
    width: @KcIconSize@px;
    height: @KcIconSize@px;
}

/* -------------------------------------------------------- views and tables */

QAbstractItemView {
    background-color: @KcSurfaceRaised@;
    alternate-background-color: @KcSurfaceBase@;
    color: @KcTextPrimary@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSmall@px;
    gridline-color: @KcBorderSubtle@;
    selection-background-color: @KcSurfaceSelected@;
    selection-color: @KcTextPrimary@;
    outline: none;
}

QTableView::item, QListWidget::item, QTreeWidget::item, QListView::item {
    padding: @KcSpacingMd@px @KcSpacingLg@px;
    border: none;
}

QTableView::item:hover, QListWidget::item:hover,
QTreeWidget::item:hover, QListView::item:hover {
    background-color: @KcSurfaceControlHover@;
}

QTableView::item:selected, QListWidget::item:selected,
QTreeWidget::item:selected, QListView::item:selected {
    background-color: @KcSurfaceSelected@;
    color: @KcTextPrimary@;
}

/* A view that is not focused still has to show what is selected - the user's
 * choice did not become less true because they clicked elsewhere. */
QAbstractItemView:!focus {
    selection-background-color: @KcSurfaceSelected@;
    selection-color: @KcTextPrimary@;
}

QHeaderView {
    background-color: @KcSurfaceHeader@;
}

QHeaderView::section {
    background-color: @KcSurfaceHeader@;
    color: @KcTextSecondary@;
    border: none;
    border-right: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-bottom: @KcBorderWidth@px solid @KcBorderSubtle@;
    padding: @KcSpacingMd@px @KcSpacingLg@px;
    font-size: @KcFontSizeXs@px;
    font-weight: @KcFontWeightMedium@;
}

QHeaderView::section:hover {
    background-color: @KcSurfaceControlHover@;
    color: @KcTextPrimary@;
}

QHeaderView::up-arrow {
    image: url(kc:chevron-up.svg);
    width: @KcIconSize@px;
    height: @KcIconSize@px;
}

QHeaderView::down-arrow {
    image: url(kc:chevron-down.svg);
    width: @KcIconSize@px;
    height: @KcIconSize@px;
}

QTableCornerButton::section {
    background-color: @KcSurfaceHeader@;
    border: none;
}

/* ------------------------------------------------------------ scroll areas */
/* The viewport of a scroll area is a plain child widget, and a plain child
 * widget takes the *platform* window colour. On a Windows 11 machine in dark
 * mode that is a dark rectangle, which is invisible in the dark theme and a
 * black island in the light one. This is the rule that fixes that. */

QAbstractScrollArea {
    background-color: @KcSurfaceRaised@;
    border: none;
}

QAbstractScrollArea > QWidget > QWidget {
    background-color: @KcSurfaceRaised@;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: @KcSurfaceRaised@;
}

QScrollArea[kcSurface="base"],
QScrollArea[kcSurface="base"] > QWidget > QWidget {
    background-color: @KcSurfaceBase@;
}

/* A scroll area that is a mechanism, not a panel: it stands inside a surface
 * that has already been painted and must not draw a second lighter rectangle
 * over it. Used by the label summary, which scrolls without a bar. */
QScrollArea[kcSurface="none"],
QScrollArea[kcSurface="none"] > QWidget > QWidget {
    background-color: transparent;
}

QStackedWidget, QSplitter, QTabWidget {
    background-color: transparent;
}

/* --------------------------------------------------------------------- tabs */

QTabWidget::pane {
    background-color: @KcSurfaceRaised@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSmall@px;
    top: -@KcBorderWidth@px;
    /* The labelling inspector lives in one of these. Without this its
       headings and its help text were painted against the pane border. */
    padding: @KcSpacingXl@px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: @KcSurfaceHeader@;
    color: @KcTextSecondary@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-bottom: none;
    border-top-left-radius: @KcRadiusSmall@px;
    border-top-right-radius: @KcRadiusSmall@px;
    padding: @KcSpacingMd@px @KcSpacingXl@px;
    margin-right: @KcSpacingXs@px;
}

QTabBar::tab:hover {
    background-color: @KcSurfaceControlHover@;
    color: @KcTextPrimary@;
}

QTabBar::tab:selected {
    background-color: @KcSurfaceRaised@;
    color: @KcTextPrimary@;
    border-color: @KcBorderSubtle@;
    font-weight: @KcFontWeightMedium@;
}

QTabBar::tab:focus {
    border: @KcBorderWidthStrong@px solid @KcFocusRing@;
}

/* -------------------------------------------------------------- menus */

QMenu {
    background-color: @KcSurfaceOverlay@;
    color: @KcTextPrimary@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    border-radius: @KcRadiusControl@px;
    padding: @KcSpacingMd@px;
}

QMenu::item {
    padding: @KcSpacingMd@px @KcSpacingXxl@px @KcSpacingMd@px @KcSpacingLg@px;
    border-radius: @KcRadiusSmall@px;
}

QMenu::item:selected {
    background-color: @KcSurfaceSelected@;
    color: @KcTextPrimary@;
}

QMenu::item:disabled {
    color: @KcTextDisabled@;
}

QMenu::separator {
    height: @KcBorderWidth@px;
    background-color: @KcBorderSubtle@;
    margin: @KcSpacingSm@px @KcSpacingMd@px;
}

QMenuBar {
    background-color: @KcSurfaceHeader@;
    color: @KcTextPrimary@;
}

QMenuBar::item:selected {
    background-color: @KcSurfaceControlHover@;
}

/* --------------------------------------------------------------- grouping */

QGroupBox {
    background-color: @KcSurfaceRaised@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSurface@px;
    margin-top: @KcSpacingXl@px;
    padding: @KcSpacingXl@px;
    font-weight: @KcFontWeightMedium@;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: @KcSpacingLg@px;
    padding: 0 @KcSpacingSm@px;
    color: @KcTextSecondary@;
}

/* ------------------------------------------------------------- progress */

QProgressBar {
    background-color: @KcSurfaceControl@;
    border: @KcBorderWidth@px solid @KcBorderSubtle@;
    border-radius: @KcRadiusSmall@px;
    text-align: center;
    color: @KcTextSecondary@;
    min-height: @KcControlHeight@px;
}

QProgressBar::chunk {
    background-color: @KcAccentPrimary@;
    border-radius: @KcRadiusSmall@px;
}

/* ------------------------------------------------------------- scroll bars */

QScrollBar:vertical {
    background: transparent;
    width: @KcSpacingLg@px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @KcScrollbar@;
    min-height: @KcControlHeight@px;
    border-radius: @KcRadiusSmall@px;
}

QScrollBar::handle:vertical:hover {
    background: @KcScrollbarHover@;
}

QScrollBar:horizontal {
    background: transparent;
    height: @KcSpacingLg@px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: @KcScrollbar@;
    min-width: @KcControlHeight@px;
    border-radius: @KcRadiusSmall@px;
}

QScrollBar::handle:horizontal:hover {
    background: @KcScrollbarHover@;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

/* ------------------------------------------------------------- message bar */

QFrame[kcMessage="info"] {
    background-color: @KcSurfaceOverlay@;
    border: @KcBorderWidth@px solid @KcBorderStrong@;
    border-left: @KcSpacingSm@px solid @KcAccentPrimary@;
    border-radius: @KcRadiusControl@px;
}

QFrame[kcMessage="warning"] {
    background-color: @KcSurfaceOverlay@;
    border: @KcBorderWidth@px solid @KcStatusWarning@;
    border-left: @KcSpacingSm@px solid @KcStatusWarning@;
    border-radius: @KcRadiusControl@px;
}

QFrame[kcMessage="error"] {
    background-color: @KcSurfaceOverlay@;
    border: @KcBorderWidth@px solid @KcStatusRecording@;
    border-left: @KcSpacingSm@px solid @KcStatusRecording@;
    border-radius: @KcRadiusControl@px;
}

/* ---------------------------------------------------------------- splitters */

QSplitter::handle {
    background-color: @KcSurfaceBase@;
}

QSplitter::handle:hover {
    background-color: @KcAccentPrimary@;
}

QSplitter::handle:horizontal {
    width: @KcSpacingSm@px;
    image: none;
}

QSplitter::handle:vertical {
    height: @KcSpacingSm@px;
    image: none;
}
