{
  "schema_version": "1.0.0",
  "_comment": [
    "Single source of truth for every colour, metric and type value in the",
    "Studio interface. Nothing in views/ may write a literal colour or size;",
    "a test enforces that. Token names are chosen to read like WinUI resource",
    "keys so the same file can generate a ResourceDictionary later.",
    "",
    "Colour carries meaning, never decoration:",
    "  KcStatusRecording  red     - recording and errors, nothing else",
    "  KcStatusWarning    yellow  - warning and uncertainty, nothing else",
    "  KcStatusLive       green   - live and complete, nothing else",
    "  KcAccentPrimary    blue    - selection and focus, nothing else"
  ],
  "default_theme": "dark",
  "metrics": {
    "KcSpacingXs": 2,
    "KcSpacingSm": 4,
    "KcSpacingMd": 8,
    "KcSpacingLg": 12,
    "KcSpacingXl": 16,
    "KcRadiusControl": 2,
    "KcRadiusSurface": 0,
    "KcBorderWidth": 1,
    "KcControlHeight": 24,
    "KcControlHeightLarge": 30,
    "KcContextBarHeight": 30,
    "KcNavBarHeight": 46,
    "KcInspectorWidth": 320,
    "KcInspectorMinWidth": 240,
    "KcIconSize": 16,
    "KcIconSizeLarge": 20,
    "KcWindowMinWidth": 1120,
    "KcWindowMinHeight": 700
  },
  "typography": {
    "KcFontFamily": "Segoe UI, Inter, system-ui, sans-serif",
    "KcFontMono": "Consolas, Cascadia Mono, monospace",
    "KcFontSizeXs": 10,
    "KcFontSizeSm": 11,
    "KcFontSizeMd": 12,
    "KcFontSizeLg": 14,
    "KcFontSizeTitle": 15,
    "KcFontWeightNormal": 400,
    "KcFontWeightMedium": 600
  },
  "themes": {
    "dark": {
      "label": "Koyu",
      "is_dark": true,
