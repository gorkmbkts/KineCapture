        "KcSurfaceViewport": "#0b0c0e",
        "KcSurfaceOverlay": "#1a1c20",
        "KcBorderSubtle": "#26292e",
        "KcBorderStrong": "#383c43",
        "KcTextPrimary": "#e4e6e9",
        "KcTextSecondary": "#a9aeb6",
        "KcTextMuted": "#747a83",
        "KcTextDisabled": "#565b63",
        "KcTextOnAccent": "#ffffff",
        "KcAccentPrimary": "#3d7dff",
        "KcAccentPrimaryHover": "#548dff",
        "KcAccentMuted": "#22355c",
        "KcFocusRing": "#6ea0ff",
        "KcStatusRecording": "#e04a3c",
        "KcStatusRecordingMuted": "#4a1f1b",
        "KcStatusWarning": "#d9a13b",
        "KcStatusWarningMuted": "#45361c",
